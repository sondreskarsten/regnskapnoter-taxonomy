{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regnskapnoter-taxonomy/schemas/concept-frontmatter.schema.json",
  "title": "regnskap-no Concept Front-Matter",
  "type": "object",
  "required": [
    "concept_id",
    "namespace",
    "period_type",
    "data_type",
    "substitution_group",
    "abstract",
    "status",
    "introduced_version",
    "labels",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "concept_id": {
      "type": "string",
      "pattern": "^regnskap-no:[A-Z][A-Za-z0-9]+$"
    },
    "namespace": {
      "type": "string",
      "enum": ["regnskap-no"]
    },
    "period_type": {
      "type": "string",
      "enum": ["instant", "duration"]
    },
    "balance": {
      "type": ["string", "null"],
      "enum": ["debit", "credit", null]
    },
    "data_type": {
      "type": "string",
      "enum": [
        "monetaryItemType",
        "stringItemType",
        "decimalItemType",
        "sharesItemType",
        "pureItemType",
        "dateItemType",
        "textBlockItemType",
        "booleanItemType",
        "integerItemType",
        "percentItemType"
      ]
    },
    "substitution_group": {
      "type": "string",
      "enum": ["item", "hypercubeItem", "dimensionItem"]
    },
    "abstract": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["candidate", "standard", "deprecated", "retired"]
    },
    "introduced_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "deprecated_date": { "type": ["string", "null"], "format": "date" },
    "deprecated_replacement": { "type": ["string", "null"] },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lang", "role", "text"],
        "additionalProperties": false,
        "properties": {
          "lang": { "type": "string", "enum": ["nb", "en"] },
          "role": {
            "type": "string",
            "enum": [
              "standardLabel",
              "terseLabel",
              "verboseLabel",
              "documentationLabel",
              "totalLabel",
              "periodStartLabel",
              "periodEndLabel",
              "negatedLabel",
              "deprecatedLabel"
            ]
          },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["publisher", "document", "paragraph", "applicable_from_fiscal_year"],
        "additionalProperties": false,
        "properties": {
          "publisher": { "type": "string", "enum": ["Stortinget", "NRS", "IFRS Foundation"] },
          "document": { "type": "string" },
          "paragraph": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "applicable_from_fiscal_year": { "type": "integer", "minimum": 1900 },
          "applicable_to_fiscal_year": { "type": ["integer", "null"], "minimum": 1900 },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lang",
          "role",
          "text",
          "source_publisher",
          "source_document",
          "source_paragraph",
          "applicable_from_fiscal_year",
          "authoritative"
        ],
        "additionalProperties": false,
        "properties": {
          "lang": { "type": "string", "enum": ["nb", "en"] },
          "role": { "type": "string", "enum": ["definition", "scopeNote", "documentationLabel"] },
          "text": { "type": "string", "minLength": 1 },
          "source_publisher": { "type": "string" },
          "source_document": { "type": "string" },
          "source_paragraph": { "type": "string" },
          "source_version": { "type": ["string", "null"] },
          "applicable_from_fiscal_year": { "type": "integer", "minimum": 1900 },
          "applicable_to_fiscal_year": { "type": ["integer", "null"], "minimum": 1900 },
          "authoritative": { "type": "boolean" }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to", "relation"],
        "additionalProperties": false,
        "properties": {
          "to": { "type": ["string", "null"] },
          "relation": {
            "type": ["string", "null"],
            "enum": [
              "skos:exactMatch",
              "skos:closeMatch",
              "skos:broadMatch",
              "skos:narrowMatch",
              "skos:relatedMatch",
              null
            ]
          },
          "quality": { "type": "string", "enum": ["exact", "approximate", "norwegian_specific"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "parent", "weight"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "pattern": "^\\[\\d{6}\\] " },
          "parent": { "type": "string", "pattern": "^regnskap-no:[A-Z][A-Za-z0-9]+$" },
          "weight": { "type": "number", "enum": [-1, 1] },
          "order": { "type": "integer", "minimum": 1 },
          "applicable_from_fiscal_year": { "type": ["integer", "null"], "minimum": 1900 },
          "applicable_to_fiscal_year": { "type": ["integer", "null"], "minimum": 1900 }
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "closed"],
        "additionalProperties": false,
        "properties": {
          "axis": { "type": "string", "pattern": "^regnskap-no:[A-Z][A-Za-z0-9]+Axis$" },
          "role": { "type": ["string", "null"] },
          "closed": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "data_type": { "const": "monetaryItemType" } } },
      "then": { "required": ["balance"] }
    },
    {
      "if": { "properties": { "data_type": { "not": { "const": "monetaryItemType" } } } },
      "then": {
        "properties": {
          "balance": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "deprecated" } } },
      "then": { "required": ["deprecated_date"] }
    }
  ]
}
